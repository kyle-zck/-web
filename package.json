{
  "name": "short-drama-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev:kill": "bash -c 'for p in 3000 3001 3002 3003 3010; do lsof -ti:$p 2>/dev/null | xargs kill -9 2>/dev/null; done; true'",
    "dev": "WATCHPACK_POLLING=true PORT=3000 next dev",
    "dev:clean": "npm run clean && WATCHPACK_POLLING=true PORT=3000 next dev",
    "dev:reset": "npm run dev:kill && npm run clean && WATCHPACK_POLLING=true PORT=3000 next dev",
    "dev:turbo": "WATCHPACK_POLLING=true PORT=3000 next dev --turbo",
    "health:local": "node scripts/health-check-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:series-pg": "node --env-file=.env.local scripts/check-series-pg.mjs",
    "check:prod-assets": "node --env-file=.env.local scripts/check-prod-assets.mjs",
    "migrate:public-urls:pg": "node --env-file=.env.local scripts/migrate-public-urls-pg.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "hls.js": "^1.6.15",
    "i18next": "^25.8.18",
    "jose": "^6.2.2",
    "next": "14.2.35",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-player": "^3.4.0",
    "recharts": "^3.8.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
