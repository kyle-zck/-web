# 复制为 .env.local 后填写，切勿提交 .env.local
# Copy to .env.local and fill in; never commit .env.local

# --- Admin（后台登录，首次可用环境变量明文）---
ADMIN_KEY=
# 可选：JWT 签名（默认回退 ADMIN_KEY）
# ADMIN_SESSION_SECRET=

# --- 数据存储：local | sqlite | pg ---
# 生产 / Vercel 请用 pg + 下方数据库 URL
SERIES_STORAGE=local

# --- PostgreSQL：Supabase（推荐）或其它托管库 ---
# 任选其一即可；代码统一读取见 lib/db/url.ts
# Supabase：Project Settings → Database → Connection string → URI
# Serverless 建议用 Transaction pooler（port 6543，含 pgbouncer 参数）
DATABASE_URL=
# 若你更习惯单独命名：
# SUPABASE_DB_URL=
PG_URL=

# --- Supabase 客户端（可选，用于后续 Auth / 控制台）---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- S3 兼容对象存储：Cloudflare R2（封面等；未配置时开发环境可写 public/uploads）---
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 可填 auto，或不填（代码在 R2 域名下默认 auto）
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对外访问前缀：自定义域名或 R2 公开访问 URL
S3_PUBLIC_BASE_URL=
