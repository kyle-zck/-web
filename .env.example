# 复制为 .env.local 后填写，切勿提交 .env.local
# Copy to .env.local and fill in; never commit .env.local

# --- Admin（后台登录，首次可用环境变量明文）---
ADMIN_KEY=
# 可选：JWT 签名（默认回退 ADMIN_KEY）
# ADMIN_SESSION_SECRET=

# --- 数据存储：local | sqlite | pg ---
# 生产 / Vercel 请用 pg + 下方数据库 URL
# SERIES_STORAGE=pg 时，后台「管理标签」目录会存 PostgreSQL 表 drama_tag_catalog（首次访问自动建表）
SERIES_STORAGE=local

# --- PostgreSQL：Supabase（推荐）或其它托管库 ---
# 任选其一即可；代码统一读取见 lib/db/url.ts
# Supabase：Project Settings → Database → Connection string → URI
# Serverless 建议用 Transaction pooler（port 6543，含 pgbouncer 参数）
DATABASE_URL=
# 若你更习惯单独命名：
# SUPABASE_DB_URL=
PG_URL=

# 可选：站点配置（app-config）在 next build 时强制只读本地 data/app-config.json、不写 PG
# 默认在 npm run build 下已自动跳过远程 PG；仅当你直接运行 next build 且静态生成超时时再设
# NEXT_SKIP_APP_CONFIG_PG=1

# --- Supabase 客户端（可选，用于后续 Auth / 控制台）---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- S3 兼容对象存储：Cloudflare R2（封面等；未配置时开发环境可写 public/uploads）---
# 生产务必配置，使 cover/poster 为短 HTTPS URL，勿把几 MB 的 Base64 存进数据库
# 图文步骤：docs/COVER-CDN-AND-API-CACHE.md
# 一步步操作（含 Network 自检）：docs/PERF-OPTIMIZATION-STEPS.md
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 可填 auto，或不填（代码在 R2 域名下默认 auto）
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 浏览器可访问的 HTTPS 前缀（自定义域名 cdn 或 R2 Public URL），勿以裸内网 Endpoint 给前端
S3_PUBLIC_BASE_URL=

# 本地上传剧目时各集使用的示例 MP4（体积较小，加载更快）；不填则用内置 MDN 示例
# NEXT_PUBLIC_SAMPLE_VIDEO_URL=https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4

# 后台「上传视频文件」单文件上限（字节），默认约 120MB；无服务器环境若超限请改用 HTTPS 直链
# ADMIN_VIDEO_UPLOAD_MAX_BYTES=125829120

# 前台 /api/series、/api/tag-catalog、/api/app-config 缓存秒数（CDN/Vercel Edge 会认 Cache-Control；默认代码内已提高）
# 详见 docs/COVER-CDN-AND-API-CACHE.md
# PUBLIC_SERIES_API_REVALIDATE=120
# PUBLIC_TAG_CATALOG_REVALIDATE=300
# 站点配置 /api/app-config（导航品牌名、Logo 等），默认 120 秒
# PUBLIC_APP_CONFIG_REVALIDATE=120
# 播放页 getSeriesById 服务端缓存秒数（减轻 DB，改剧后略延迟可见；默认 45）
# PUBLIC_SERIES_DETAIL_REVALIDATE=45
