# 复制为 .env.local 后填写，切勿提交 .env.local
# Copy to .env.local and fill in; never commit .env.local

# --- Admin ---
# 生产环境务必设为强随机字符串（勿使用默认 admin）
ADMIN_KEY=
# 可选：JWT 会话签名用（默认回退为 ADMIN_KEY）；建议生产单独设长随机串
# ADMIN_SESSION_SECRET=

# --- 剧目数据存储：local | sqlite | pg ---
# 本地开发可用 local；Vercel 等 Serverless 请用 pg + DATABASE_URL（见 VERCEL.md）
SERIES_STORAGE=local

# --- PostgreSQL（SERIES_STORAGE=pg 时）---
# 二选一即可
PG_URL=
DATABASE_URL=

# --- S3 兼容对象存储（封面上传；未配置时开发环境可回退到本地 public）---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对外访问封面 URL 前缀（CDN 或桶公共域名）
S3_PUBLIC_BASE_URL=
